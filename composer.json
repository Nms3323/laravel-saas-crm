{
    "name": "username/laravel-saas-crm",
    "description": "Production-ready SaaS CRM scaffold built with Laravel",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-permission": "^5.0 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.9",
        "vimeo/psalm": "^5.0",
        "nunomaduro/larastan": "^2.0",
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "rector/rector": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "psalm": "vendor/bin/psalm"
    }
}
